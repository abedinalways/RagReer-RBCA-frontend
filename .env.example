# ------------------------------------------------------------------
# Environment variables for RagReer RBCA
# Copy to `.env.local` to override defaults.
# ------------------------------------------------------------------

# Mock session role used by the scaffold auth-slice (ADMIN | CUSTOMER | WORKER).
NEXT_PUBLIC_MOCK_ROLE=ADMIN

# Base URL of your backend API used by store/api/api-client.ts
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000