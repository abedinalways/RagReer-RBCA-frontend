# ------------------------------------------------------------------
# Environment variables for RagReer RBCA
# Copy to `.env.local` to override defaults.
# ------------------------------------------------------------------

# Base URL of your backend API used by redux/api/baseApi.ts & store/api/api-client.ts
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Design mode — when true the app renders against mocked data (no network).
# Set to false in production so all API calls hit the real backend.
NEXT_PUBLIC_DESIGN_MODE=true

# Public origin used to resolve uploaded media / storage paths
NEXT_PUBLIC_MEDIA_BASE_URL=